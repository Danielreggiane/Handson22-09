import java.util.Scanner;

public class DescontoCliente {

    public static void main(String[] args) {
        Scanner leitor = new Scanner(System.in);

        System.out.print("Digite o valor da compra: R$ ");
        double valorCompra = leitor.nextDouble();

        System.out.println("1 - Comum");
        System.out.println("2 - Premium");
        System.out.println("3 - Funcionario");
        System.out.print("Digite a categoria do cliente: ");
        int categoria = leitor.nextInt();

        if (categoria == 1) {
            double desconto = valorCompra * 0.05;
            double valorFinal = valorCompra - desconto;

            System.out.println("Valor do desconto: R$ " + desconto);
            System.out.println("Valor final a pagar: R$ " + valorFinal);

        } else if (categoria == 2) {
            double desconto = valorCompra * 0.10;
            double valorFinal = valorCompra - desconto;

            System.out.println("Valor do desconto: R$ " + desconto);
            System.out.println("Valor final a pagar: R$ " + valorFinal);

        } else if (categoria == 3) {
            double desconto = valorCompra * 0.15;
            double valorFinal = valorCompra - desconto;

            System.out.println("Valor do desconto: R$ " + desconto);
            System.out.println("Valor final a pagar: R$ " + valorFinal);

        } else {
            System.out.println("Categoria invalida");
        }

        leitor.close();
    }
}
